#!/usr/bin/env bash
# omarchy-radio no terminal: toca as radios do site, sem navegador e sem video.
# Site: https://fabiosilverio.github.io/omarchy-radio/
set -u

SITE_URL="https://fabiosilverio.github.io/omarchy-radio/"
DATA_URL="${RADIO_DATA_URL:-https://fabiosilverio.github.io/omarchy-radio/tracks-data.js}"
RAW_RADIO="https://raw.githubusercontent.com/FabioSilverio/omarchy-radio/main/cli/radio"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-radio"
mkdir -p "$STATE"
QUEUE="$STATE/queue.tsv"; CURRENT="$STATE/current"; STATION_FILE="$STATE/station"
LOOP_PID_FILE="$STATE/loop.pid"; SOCK="$STATE/mpv.sock"; LOG="$STATE/player.log"
DATA_CACHE="$STATE/tracks-data.js"; VOL_FILE="$STATE/volume"
[ -f "$VOL_FILE" ] || echo 80 > "$VOL_FILE"

STATIONS_HELP="jonas | tiktok | 2010 | tops"

station_key() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    jonas|jonasbrothers|brothers) echo jonas ;;
    tiktok|tik|hoje) echo tiktok ;;
    2010|hits2010|hits) echo hits2010 ;;
    tops|alltime|maiores|historicas) echo alltime ;;
    *) echo "" ;;
  esac
}
station_name() {
  case "$1" in
    jonas) echo "Jonas Brothers Radio" ;;
    tiktok) echo "Hits no TikTok Hoje" ;;
    hits2010) echo "Hits 2010" ;;
    alltime) echo "Mais Ouvidas de Todos os Tempos" ;;
  esac
}
station_slogan() {
  case "$1" in
    jonas) echo "Você está ouvindo Jonas Brothers Radio, na Omarchy Radio." ;;
    tiktok) echo "Você está ouvindo Hits no TikTok Hoje, na Omarchy Radio." ;;
    hits2010) echo "Você está ouvindo Hits 2010, na Omarchy Radio." ;;
    alltime) echo "Você está ouvindo as Mais Ouvidas de Todos os Tempos, na Omarchy Radio." ;;
  esac
}

fetch_data() {
  if curl -fsSL -m 20 "$DATA_URL" -o "$DATA_CACHE.tmp" 2>/dev/null && [ -s "$DATA_CACHE.tmp" ]; then
    mv "$DATA_CACHE.tmp" "$DATA_CACHE"
  fi
  [ -s "$DATA_CACHE" ] || { echo "Sem internet e sem cache de faixas. Conecte e tente de novo." >&2; exit 1; }
}

# Gera a fila embaralhada da estacao: id <tab> artista <tab> titulo
make_queue() {
  python3 - "$DATA_CACHE" "$1" "${2:-}" <<'PY'
import json, random, sys
raw = open(sys.argv[1], encoding="utf-8").read()
data = json.loads(raw[raw.index("{"):raw.rindex(";")])
tracks = data.get(sys.argv[2], [])
rows = [t for t in tracks if len(t) == 3]
random.shuffle(rows)
first = sys.argv[3]
if first:
    rows.sort(key=lambda t: 0 if t[2] == first else 1)
for artist, title, vid in rows:
    print(f"{vid}\t{artist}\t{title}")
PY
}

mpv_ipc() { # $1 = JSON do comando mpv
  python3 - "$SOCK" "$1" <<'PY'
import socket, sys, json
try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM); s.settimeout(2)
    s.connect(sys.argv[1]); s.sendall((sys.argv[2] + "\n").encode())
    data = s.recv(4096).decode(errors="ignore"); s.close()
    for line in data.splitlines():
        try:
            d = json.loads(line)
            if "data" in d: print(d["data"]); break
        except Exception: pass
except Exception:
    pass
PY
}

is_playing_loop() { [ -f "$LOOP_PID_FILE" ] && kill -0 "$(cat "$LOOP_PID_FILE")" 2>/dev/null; }

vinheta_falada() {
  echo "♪ VINHETA ♪ $1"
  if command -v spd-say >/dev/null 2>&1; then spd-say -l pt -r 5 "$1" 2>/dev/null || true
  elif command -v espeak-ng >/dev/null 2>&1; then espeak-ng -v pt-br "$1" 2>/dev/null || true
  fi
}

URL_DIR="$STATE/urls"
cached_url() { # $1=id -> URL direta fresca (<3h) ou vazio
  local f="$URL_DIR/$1.url"
  [ -s "$f" ] || return 0
  [ $(( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) )) -lt 10800 ] && cat "$f"
}
resolve_into_cache() { # $1=id (usado no prefetch da proxima)
  mkdir -p "$URL_DIR"
  local tmp="$URL_DIR/$1.tmp"
  yt-dlp -g -f "bestaudio/best" --no-warnings "https://www.youtube.com/watch?v=$1" > "$tmp" 2>/dev/null \
    && [ -s "$tmp" ] && mv "$tmp" "$URL_DIR/$1.url" || rm -f "$tmp"
}
mpv_play() { # $1=fonte
  mpv --no-video --really-quiet --input-ipc-server="$SOCK" --volume="$(cat "$VOL_FILE")" \
      ${RADIO_MPV_OPTS:-} "$1" >>"$LOG" 2>&1
}
play_one() { # $1=id $2=artista $3=titulo ; retorna 0 se tocou, 1 se falhou rapido
  local id="$1" start elapsed rc direct
  printf '%s — %s' "$2" "$3" > "$CURRENT"
  echo "▶ $2 — $3"
  # 1) URL ja resolvida pelo prefetch (comeca na hora, sem comercial)
  direct=$(cached_url "$id")
  if [ -n "$direct" ]; then
    start=$(date +%s); mpv_play "$direct"; rc=$?; elapsed=$(( $(date +%s) - start ))
    if [ $rc -eq 0 ] || [ $elapsed -ge 8 ]; then return 0; fi
    rm -f "$URL_DIR/$id.url"; echo "  link preparado expirou — tentando youtube..." >&2
  fi
  # 2) youtube via mpv
  start=$(date +%s); mpv_play "https://www.youtube.com/watch?v=$id"; rc=$?; elapsed=$(( $(date +%s) - start ))
  if [ $rc -eq 0 ] || [ $elapsed -ge 8 ]; then return 0; fi
  # 3) yt-dlp na hora
  echo "  fonte youtube falhou — tentando yt-dlp..." >&2
  direct=$(yt-dlp -g -f "bestaudio/best" --no-warnings "https://www.youtube.com/watch?v=$id" 2>/dev/null | head -1)
  [ -n "$direct" ] || return 1
  start=$(date +%s); mpv_play "$direct"; rc=$?; elapsed=$(( $(date +%s) - start ))
  { [ $rc -eq 0 ] || [ $elapsed -ge 8 ]; }
}

loop_player() {
  local station="$1" count=0 i id artist title nid
  echo $$ > "$LOOP_PID_FILE"
  trap 'rm -f "$LOOP_PID_FILE" "$SOCK"; exit 0' TERM INT
  while :; do
    [ -s "$QUEUE" ] || make_queue "$station" > "$QUEUE"
    mapfile -t _lines < "$QUEUE"
    for i in "${!_lines[@]}"; do
      IFS=$'\t' read -r id artist title <<< "${_lines[$i]}"
      [ -n "$id" ] || continue
      # prefetch: enquanto esta toca, ja resolve a proxima (comeca instantanea e sem comercial)
      if [ $((i + 1)) -lt ${#_lines[@]} ]; then
        nid=$(printf '%s' "${_lines[$((i + 1))]}" | cut -f1)
        [ -n "$(cached_url "$nid")" ] || ( resolve_into_cache "$nid" ) &
      fi
      count=$((count + 1))
      if [ $count -gt 1 ] && [ $(( (count - 1) % 3 )) -eq 0 ]; then vinheta_falada "$(station_slogan "$station")"; fi
      play_one "$id" "$artist" "$title" || echo "  faixa indisponível, pulando: $artist — $title" >&2
    done
    make_queue "$station" > "$QUEUE"   # acabou a fila: embaralha tudo de novo, radio infinita
  done
}

cmd_stop() {
  if is_playing_loop; then
    mpv_ipc '{"command":["quit"]}' >/dev/null
    kill "$(cat "$LOOP_PID_FILE")" 2>/dev/null || true
    sleep 0.3; rm -f "$LOOP_PID_FILE" "$SOCK"
    echo "Rádio desligada."
  else echo "Nada tocando."; fi
}

cmd_start() {
  local key; key=$(station_key "${1:-}")
  [ -n "$key" ] || { echo "Estação desconhecida: ${1:-}"; echo "Use: radio $STATIONS_HELP"; exit 1; }
  command -v mpv >/dev/null && command -v yt-dlp >/dev/null || { echo "Faltam mpv/yt-dlp: sudo pacman -S mpv yt-dlp" >&2; exit 1; }
  fetch_data
  cmd_stop >/dev/null 2>&1 || true
  make_queue "$key" "${2:-}" > "$QUEUE"
  echo "$key" > "$STATION_FILE"
  setsid -f "$0" _loop "$key" >>"$LOG" 2>&1
  sleep 1
  echo "No ar: $(station_name "$key") — $(wc -l < "$QUEUE") faixas em shuffle"
  echo "Controles: radio status | radio prox | radio pausa | radio stop"
}

cmd_status() {
  if is_playing_loop; then
    local pos dur paused
    pos=$(mpv_ipc '{"command":["get_property","time-pos"]}'); dur=$(mpv_ipc '{"command":["get_property","duration"]}')
    paused=$(mpv_ipc '{"command":["get_property","pause"]}')
    printf '♪ %s  [%s]\n' "$(cat "$CURRENT" 2>/dev/null)" "$(station_name "$(cat "$STATION_FILE" 2>/dev/null)")"
    if [ -n "${pos:-}" ] && [ -n "${dur:-}" ]; then
      printf '  %d:%02d / %d:%02d%s · volume %s\n' \
        $(( ${pos%.*} / 60 )) $(( ${pos%.*} % 60 )) $(( ${dur%.*} / 60 )) $(( ${dur%.*} % 60 )) \
        "$([ "$paused" = "True" ] || [ "$paused" = "true" ] && echo ' · pausado')" "$(cat "$VOL_FILE")"
    fi
  else echo "Nada tocando. Comece com: radio jonas"; fi
}

usage() {
  cat <<EOF
omarchy-radio no terminal — as rádios de $SITE_URL

  radio                  escolhe a rádio num menu (ou lista as opções)
  radio jonas            toca Jonas Brothers Radio
  radio tiktok           toca Hits no TikTok Hoje
  radio 2010             toca Hits 2010
  radio tops             toca Mais Ouvidas de Todos os Tempos
  radio toca <busca>     toca a primeira música que bater com a busca
  radio busca <busca>    lista músicas que batem com a busca
  radio status           o que está tocando agora
  radio prox             próxima música
  radio pausa            pausa / continua
  radio vol <0-100>      volume
  radio stop             desliga a rádio
  radio site             abre o site no navegador
  radio atualizar        atualiza o comando radio
EOF
}

case "${1:-}" in
  _loop) loop_player "$2" ;;
  ""|menu)
    if [ -t 0 ] && command -v fzf >/dev/null 2>&1; then
      choice=$(printf 'jonas — Jonas Brothers Radio\ntiktok — Hits no TikTok Hoje\n2010 — Hits 2010\ntops — Mais Ouvidas de Todos os Tempos\n' | fzf --prompt='radio> ' --height=8) || exit 0
      cmd_start "${choice%% *}"
    else usage; fi ;;
  jonas|tiktok|2010|hits2010|tops|alltime) cmd_start "$1" ;;
  tocar|toca|play) shift; cmd_start "${1:?uso: radio toca <estacao-ou-busca>}" ;;
  busca|search)
    shift; fetch_data
    python3 - "$DATA_CACHE" "$*" <<'PY'
import json, sys
raw = open(sys.argv[1], encoding="utf-8").read()
data = json.loads(raw[raw.index("{"):raw.rindex(";")])
q = sys.argv[2].lower()
for st, tracks in data.items():
    for artist, title, vid in tracks:
        if q in (artist + " " + title).lower(): print(f"[{st}] {artist} — {title}")
PY
    ;;
  status|st) cmd_status ;;
  prox|next|pular) mpv_ipc '{"command":["quit"]}' >/dev/null; echo "Próxima..." ;;
  pausa|pause) mpv_ipc '{"command":["cycle","pause"]}' >/dev/null; cmd_status ;;
  vol|volume)
    v="${2:-}"; case "$v" in ''|*[!0-9]*) echo "uso: radio vol 0-100";; *) echo "$v" > "$VOL_FILE"; mpv_ipc "{\"command\":[\"set_property\",\"volume\",$v]}" >/dev/null; echo "Volume: $v";; esac ;;
  stop|parar) cmd_stop ;;
  site|abrir) xdg-open "$SITE_URL" >/dev/null 2>&1; echo "Abrindo $SITE_URL" ;;
  atualizar|update)
    tmp=$(mktemp); curl -fsSL "$RAW_RADIO" -o "$tmp" && install -m755 "$tmp" "$0" && rm -f "$tmp" && echo "Comando radio atualizado." || { rm -f "$tmp"; echo "Falha ao atualizar." >&2; exit 1; } ;;
  -h|--help|help|ajuda) usage ;;
  *)
    # radio toca <busca livre>: procura a musica e toca ela + a radio dela
    if fetch_data 2>/dev/null; then
      hit=$(python3 - "$DATA_CACHE" "$*" <<'PY'
import json, sys
raw = open(sys.argv[1], encoding="utf-8").read()
data = json.loads(raw[raw.index("{"):raw.rindex(";")])
q = sys.argv[2].lower()
for st, tracks in data.items():
    for artist, title, vid in tracks:
        if q in (artist + " " + title).lower(): print(st, vid); sys.exit()
PY
)
      if [ -n "$hit" ]; then cmd_start ${hit% *} "${hit##* }"; exit 0; fi
    fi
    echo "Não entendi: $*"; usage; exit 1 ;;
esac
